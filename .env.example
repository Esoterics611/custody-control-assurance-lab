# custody-control-assurance-lab — example environment
#
# IMPORTANT: This lab is SYNTHETIC and DEFENSIVE. NO real secrets, private keys,
# sanctions feeds, exchange credentials, or API tokens belong in this file or
# anywhere in this repo. Everything below is non-sensitive local configuration.

# Host/port for the local API + security console (make serve).
CAL_HOST=127.0.0.1
CAL_PORT=8000

# --- Optional Phase 8 (live on-chain assurance target) ---
# Public read-only RPC for a PUBLIC TESTNET only (e.g. Base Sepolia). Never a
# mainnet key, never a private key. Used only to READ control state and submit
# transactions that are EXPECTED TO BE BLOCKED by on-chain controls.
# CAL_ONCHAIN_RPC_URL=https://base-sepolia-rpc.publicnode.com
